# Skill 评测平台 Demo 配置模板
# 复制为 .env 后填写（demo/.env 已被 git 忽略，不会误提交）
# 优先级：环境变量 > .env 文件 > 默认值；不配置 Key 时自动 mock 模式（界面明示）

# DeepSeek / 任意 OpenAI 兼容网关的 API Key（留空 = mock 模式）
DEEPSEEK_API_KEY=

# 可选：OpenAI 兼容网关地址（默认 https://api.deepseek.com）
#DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选：模型名（默认 deepseek-chat）
#DEEPSEEK_MODEL=deepseek-chat
